  "rules": [
    {
      "id": "PRI-HEAL-LATENCY",
      "desc": "Holy priest answers the player crossing below 50 percent with a heal or shield within 4 s, at least 80 percent of the time (crossings while the priest is under 10 percent mana or dead carry no chance and are skipped)",
      "source": "ai/playerbot/strategy/priest/HolyPriestStrategy.cpp:29-72",
      "expect_today": "PASS",
      "why_expect": "critical/low/medium rows all queue a heal or shield on the party member. A crossing while the priest is under 10 percent mana or dead (Spirit of Redemption) is no opportunity, not a miss: the bench skips the trigger. The governor spaces wounds 15 s apart so mana lasts the rep",
      "check": {
        "metric": "latency",
        "trigger": {
          "kind": "cross",
          "unit": "$player",
          "below": 50
        },
        "response": {
          "kind": "cast",
          "src": "$bot",
          "dst": "$player",
          "spell": [
            "Flash Heal",
            "Greater Heal",
            "Heal",
            "Lesser Heal",
            "Renew",
            "Power Word: Shield"
          ]
        },
        "within_s": 4,
        "skip_trigger_while": {
          "unit": "$bot",
          "power_below_pct": 10,
          "skip_when_dead": true
        }
      },
      "pass_if": ">= 0.8",
      "min_n": 5,
      "min_reps": 3
    }
  ],
