  "rules": [
    {
      "id": "PRI-PWS-BATTLE-CONTROL",
      "desc": "Control: the holy priest shields an Arms warrior in Battle Stance at least once below the low health band",
      "source": "ai/playerbot/strategy/priest/HolyPriestStrategy.cpp:41-49 (party member low health: shield first); ai/playerbot/strategy/priest/PriestActions.h:42",
      "expect_today": "PASS",
      "why_expect": "control: Battle Stance with Arms talents is no tank (AiFactory.cpp:503 only reads Defensive Stance), the guard must not fire",
      "check": {
        "metric": "count",
        "where": {
          "kind": "cast",
          "src": "$bot",
          "dst": "$player",
          "spell": "Power Word: Shield",
          "dst_hp_lt": "$low",
          "in_combat": true
        }
      },
      "pass_if": ">= 1",
      "min_opportunity_s": 60
    },
    {
      "id": "PRI-PWS-BATTLE-CONTROL-STANCE",
      "desc": "Precondition: Battle Stance (aura 2457) stays on the player through the fight, so the shield rule above is about this stance",
      "source": "precondition, no bot code: the stance is read by ai/playerbot/AiFactory.cpp:491-504 (GetRoleFromStanceOrGear); setup check player_stance proves it at the start, this proves it in the fight",
      "expect_today": "PASS",
      "why_expect": "the runner re-casts the stance and excludes time without it",
      "check": {
        "metric": "uptime",
        "unit": "$player",
        "aura": [
          2457
        ],
        "phase": "in_combat"
      },
      "pass_if": ">= 0.9"
    }
  ]
}
