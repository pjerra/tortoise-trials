      "id": "PRI-DISPEL-MAGIC",
      "desc": "Holy priest casts Dispel Magic on the player within 6 s of Faerie Fire (magic, no damage, 40 s) landing on him, at least 80 percent of the time",
      "source": "ai/playerbot/strategy/priest/PriestStrategy.cpp:312,333 (dispel magic on party rows); ai/playerbot/PlayerbotAISpells.cpp:1849-1876 (HasAuraToDispel: negative magic aura on a friend, at least AiPlayerbot.DispelAuraDuration 2000 ms)",
      "expect_today": "PASS",
      "why_expect": "Faerie Fire r1 (770): Dispel=magic, aura effects only (armor -176, no damage), SpellDuration index 64 = 40000 ms, hostile target type so IsPositiveSpell is false",
      "check": {
        "metric": "latency",
        "trigger": {
          "kind": "aura_on",
          "dst": "$player",
          "spell_id": [
            770
          ]
        },
        "response": {
          "kind": "cast",
          "src": "$bot",
          "dst": "$player",
          "spell": "Dispel Magic"
        },
        "within_s": 6
      },
      "pass_if": ">= 0.8",
      "min_n": 4
    }
  ]
