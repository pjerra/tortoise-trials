      "id": "PAL-BLESSING-OOC",
      "desc": "Holy paladin puts one of its blessings (single or greater) on the player within 30 s of the out-of-combat window opening",
      "source": "ai/playerbot/strategy/paladin/PaladinTriggers.cpp:292-374 (FindBlessingCandidate); ai/playerbot/strategy/paladin/PaladinActions.cpp:273,401 (GetTarget, GetBlessingForTarget); ai/playerbot/strategy/paladin/PaladinStrategy.cpp:724-733",
      "expect_today": "PASS",
      "why_expect": "FindBlessingCandidate (PaladinTriggers.cpp:339-368) walks every live group member incl. a real player with no class or master filter; GetBlessingForTarget (PaladinActions.cpp:401) gives a non-paladin warrior Blessing of Might first, so the trigger fires and the cast lands",
      "check": {
        "metric": "first",
        "where": {
          "kind": "aura_on",
          "dst": "$player",
          "spell": [
            "Blessing of Might",
            "Blessing of Wisdom",
            "Blessing of Kings",
            "Blessing of Sanctuary",
            "Blessing of Salvation",
            "Blessing of Light",
            "Greater Blessing of Might",
            "Greater Blessing of Wisdom",
            "Greater Blessing of Kings",
            "Greater Blessing of Sanctuary",
            "Greater Blessing of Salvation",
            "Greater Blessing of Light"
          ]
        }
